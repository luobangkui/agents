+#[cfg(feature = "taskarena-audit")]
+static TASKARENA_REMOVALS: std::sync::LazyLock<std::sync::Mutex<std::collections::HashMap<String, serde_json::Value>>> =
+    std::sync::LazyLock::new(|| std::sync::Mutex::new(std::collections::HashMap::new()));
+
+#[cfg(feature = "taskarena-audit")]
+fn taskarena_is_empty(p: &serde_json::Value) -> bool {
+    p["pids_current"] == 0 && p["populated"] == 0
+        && p["processes"].as_array().is_some_and(|v| v.is_empty())
+}
+
+#[cfg(feature = "taskarena-audit")]
+fn taskarena_seal_removal(cid: &str, candidate: Option<serde_json::Value>) -> Result<()> {
+    let Some(mut p) = candidate else { return Ok(()); };
+    if !taskarena_is_empty(&p) { return Err(anyhow!("removal candidate was not empty")); }
+    let path = p["cgroup_path"].as_str().ok_or_else(|| anyhow!("missing cgroup path"))?;
+    // Successful destroy plus prior zero readings, never absence alone.
+    if std::path::Path::new(path).try_exists()? { return Err(anyhow!("cgroup survived destroy")); }
+    let at = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)?.as_nanos().to_string();
+    p["proof_state"] = serde_json::json!("cgroup_removed");
+    p["removal_confirmed"] = serde_json::json!(true);
+    p["removal_unix_ns"] = serde_json::json!(at);
+    let mut records = TASKARENA_REMOVALS.lock().map_err(|_| anyhow!("removal cache poisoned"))?;
+    if records.len() >= 256 { return Err(anyhow!("removal evidence capacity reached")); }
+    records.insert(cid.to_string(), p);
+    Ok(())
+}
